#!/bin/sh
set -eu

cbor=/usr/local/bin/cbor

verify_usage() {
  echo "Usage: verify {expected|deserialize} ERA DATASET"
}

if [ "${1-}" != "verify" ]; then
  export HPCTIXFILE="/tmp/cbor-$$.tix"
  exec "$cbor" "$@"
fi

case "${2-}:${3-}" in
  --help:|expected:--help|deserialize:--help) verify_usage; exit 0 ;;
esac

# The container accepts a fixed interface and supplies the results path.
if [ "$#" -ne 4 ]; then
  verify_usage >&2
  exit 2
fi
mode=$2
dataset=$4
case "$mode" in
  expected|deserialize) ;;
  *) verify_usage >&2; exit 2 ;;
esac

# Resolve relative paths before naming the corpus's published reports.
dataset_root=$(realpath -e -- "$dataset")
dataset_name=$(basename "$dataset_root")
case "$dataset_name" in
  ''|.|..|*[!A-Za-z0-9._-]*)
    echo "unsupported dataset directory name for artifacts: $dataset_name" >&2
    exit 2
    ;;
esac

coverage_root=${CBOR_COVERAGE_DIR:-/output/coverage}
mkdir -p "$coverage_root"

timestamp=$(date -u +%Y%m%dT%H%M%SZ)
run_dir="$coverage_root/$dataset_name-$mode-$timestamp"
mkdir "$run_dir"
failure_log="$run_dir/failures.log"
tix_file="$run_dir/cbor.tix"
export HPCTIXFILE="$tix_file"

json_path="$run_dir/haskell-results.json"
markdown_path="$run_dir/haskell-report.md"
if [ "$mode" = expected ]; then
  set -- "$@" "$json_path"
fi

verify_status=0
"$cbor" "$@" 2> "$failure_log" || verify_status=$?

markdown_status=0
if [ "$mode" = expected ]; then
  report_dir="$(dirname "$dataset_root")/reports/$dataset_name"
  # Sample failures also produce JSON, so render independently of exit status.
  # The JSON path belongs to this run; an aborted run cannot reuse older results.
  if python3 "${CBOR_REPORT_SCRIPT:-/usr/local/bin/make-report.py}" \
      "$dataset_root" "$json_path" > "$markdown_path" 2>> "$failure_log" \
      && mkdir -p "$report_dir" \
      && cp -- "$json_path" "$report_dir/haskell-latest.json" \
      && cp -- "$markdown_path" "$report_dir/haskell-latest.md"; then
    echo "Conformance report: $report_dir/haskell-latest.md"
  else
    echo "conformance report generation or publication failed; retained artifacts in $run_dir" >&2
    markdown_status=1
  fi
fi

coverage_status=0
if [ ! -s "$tix_file" ]; then
  echo "coverage data was not produced: $tix_file" >&2
  coverage_status=1
else
  # Build-controlled paths contain no whitespace, so intentional word splitting
  # turns each manifest line into one hpc option.
  hpc_dirs=$(sed 's|^|--hpcdir=|' /opt/hpc/hpcdirs)
  src_dirs=$(sed 's|^|--srcdir=|' /opt/hpc/srcdirs)

  # hpc applies option updates right-to-left, so reset must follow hpcdirs.
  # shellcheck disable=SC2086
  hpc report --per-module $hpc_dirs --reset-hpcdirs "$tix_file" \
    > "$run_dir/report.txt" || coverage_status=1
  # shellcheck disable=SC2086
  hpc report --per-module --xml-output $hpc_dirs --reset-hpcdirs "$tix_file" \
    > "$run_dir/report.xml" || coverage_status=1
  mkdir -p "$run_dir/html"
  # shellcheck disable=SC2086
  hpc markup $hpc_dirs --reset-hpcdirs $src_dirs \
    --destdir="$run_dir/html" "$tix_file" \
    > "$run_dir/markup.log" 2>&1 || coverage_status=1
  if [ ! -s "$run_dir/html/hpc_index_alt.html" ]; then
    echo "alternative coverage report was not produced" >&2
    coverage_status=1
  fi
fi

echo "Coverage directory: $run_dir"
echo "Failure log:       $failure_log"
if [ "$coverage_status" -eq 0 ]; then
  echo "Coverage summary:   $run_dir/report.txt"
  echo "Alternative report: $run_dir/html/hpc_index_alt.html"
else
  echo "coverage report generation failed; retained artifacts in $run_dir" >&2
fi

if [ "$verify_status" -ne 0 ]; then
  exit "$verify_status"
fi
if [ "$markdown_status" -ne 0 ]; then
  exit "$markdown_status"
fi
exit "$coverage_status"
