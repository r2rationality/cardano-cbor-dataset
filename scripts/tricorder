#!/bin/sh
set -eu

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

# Tricorder comes from this project's Flox environment, never from the environment of a parent process such as an editor
# or an MCP server, which can have been started from another one.
for installed in "$project_dir"/.flox/run/*-dev/bin/tricorder; do
  tricorder_bin=$installed
done
: "${tricorder_bin:?Tricorder is not installed: activate the Flox environment once}"

# The cabal of the scripts/tricorder-tools directory builds in the directory that the daemon uses, so it comes first.
export TRICORDER_CABAL_BIN="$(command -v cabal)"
export PATH="$project_dir/scripts/tricorder-tools:$PATH"

exec "$tricorder_bin" "$@"
