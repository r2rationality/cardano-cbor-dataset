-- Dependency settings from Cardano Ledger revision
-- 6176e413b2be9880c23cedbdaa899f9752693b22 (also pinned in Dockerfile).
-- The checkout supplies source packages only; its local project settings are not used.

-- Cardano packages that are not on Hackage.
repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

source-repository-package
  type: git
  location: https://github.com/IntersectMBO/formal-ledger-specifications.git
  subdir: hs
  tag: acbbd74a02987678ad83d9285976328d6a6e146d

source-repository-package
  type: git
  location: https://github.com/input-output-hk/constrained-generators.git
  --sha256: sha256-h0bJTwdfJG84XrERJJoBBi5ZzRHgeVoZWS2yW/z7LiU=
  tag: 966f65f3c28cb22fc45220dbd1408baea93b53d8

source-repository-package
  type: git
  location: https://github.com/intersectmbo/cardano-base.git
  --sha256: sha256-WUBluY6UqvBkS5cNsJnKMOaW+1dTfL3mg8iq/kVPV0o=
  tag: 242f1ebde40b137ac024d8b68265e2935e0eba14
  subdir: cardano-crypto-leios

-- Keep these index states and source revisions aligned with the Ledger checkout.
index-state:
  , hackage.haskell.org 2026-07-15T21:58:35Z
  , cardano-haskell-packages 2026-08-07T15:03:01Z

packages:
  .cache/cardano-ledger/eras/allegra/impl
  .cache/cardano-ledger/eras/alonzo/impl
  .cache/cardano-ledger/eras/alonzo/test-suite
  .cache/cardano-ledger/eras/babbage/impl
  .cache/cardano-ledger/eras/conway/impl
  .cache/cardano-ledger/eras/dijkstra/impl
  .cache/cardano-ledger/eras/mary/impl
  .cache/cardano-ledger/eras/shelley/impl
  .cache/cardano-ledger/eras/shelley/test-suite
  .cache/cardano-ledger/eras/shelley-ma/test-suite
  .cache/cardano-ledger/libs/cardano-ledger-api
  .cache/cardano-ledger/libs/cardano-ledger-binary
  .cache/cardano-ledger/libs/cardano-ledger-canonical-state
  .cache/cardano-ledger/libs/cardano-ledger-core
  .cache/cardano-ledger/libs/cardano-protocol
  .cache/cardano-ledger/libs/cardano-protocol-tpraos
  .cache/cardano-ledger/libs/non-integral
  .cache/cardano-ledger/libs/small-steps
  .cache/cardano-ledger/libs/cardano-data
  .cache/cardano-ledger/libs/vector-map
  .cache/cardano-ledger/eras/byron/chain/executable-spec
  .cache/cardano-ledger/eras/byron/ledger/executable-spec
  .cache/cardano-ledger/eras/byron/ledger/impl
  .cache/cardano-ledger/eras/byron/crypto
  .cache/cardano-ledger/libs/cardano-ledger-conformance
  .cache/cardano-ledger/libs/cardano-ledger-test
  .cache/cardano-ledger/libs/plutus-preprocessor
  .cache/cardano-ledger/libs/ledger-state
  .cache/cardano-ledger/libs/cardano-ledger-repl-environment

package plutus-preprocessor
  haddock-options: "--optghc=-fplugin-opt=Plinth.Plugin:defer-errors"

package cardano-ledger-core
  flags: +asserts

package cardano-ledger-shelley
  flags: +asserts

package cardano-ledger-mary
  flags: +asserts

package cardano-ledger-conway
  flags: +asserts


if impl(ghc >=9.12)
  allow-newer:
    -- Unique: https://github.com/kapralVV/Unique/issues/11
    , Unique:hashable

source-repository-package
  type: git
  location: https://github.com/tweag/cardano-cls.git
  subdir: merkle-tree-incremental mempack-scls scls-cbor scls-format scls-core
  --sha256: sha256-xngnA6A3YNjtPXYLk1vIt/aauvibzuAhngT2sPqJp0g=
  tag: c0f41e7d3fe8e32316cb8fb8a34d7adddbe0ae0c

constraints:
  -- Happy version 2.2.1 fails to compile haskell-src-exts
  , happy < 2.2.1

if impl(ghc >=9.14)
  source-repository-package
    type: git
    -- https://github.com/snowleopard/alga/issues/322
    location: https://github.com/snowleopard/alga/
    --sha256: sha256-sQRAjHV+bor/SBt/zDtcw3tN1ir7xjjevEdyYqilNWg=
    tag: d4e43fb42db05413459fb2df493361d5a666588a

if impl(ghc >=9.14)
  constraints:
    , containers >= 0.8
    , foldl >= 1.4.18

-- cabal-allow-newer begin
if impl(ghc >=9.14)
  allow-newer:
    , canonical-json:containers
    , cborg:base
    , cborg:containers
    , constrained-generators:QuickCheck
    , dependent-map:containers
    , dictionary-sharing:containers
    , hedgehog-quickcheck:QuickCheck
    , ordered-containers:containers
    , partial-order:containers
    , persistent:template-haskell
    , safe-wild-cards:template-haskell
    , serialise:base
    , serialise:containers
    , serialise:time
-- cabal-allow-newer end

package cardano-crypto-praos
  flags: -external-libsodium-vrf
